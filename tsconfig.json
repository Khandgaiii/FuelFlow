{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "lib": ["ES2015", "DOM"],
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node"],
    "target": "ES2015"
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
